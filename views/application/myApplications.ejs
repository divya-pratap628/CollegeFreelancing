<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Applications | CollegeFreelancing</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <%- include("../partials/navbar") %>


    <main class="applications-page">

        <div class="applications-container">


            <!-- Header -->

            <div class="modern-page-header">

                <div>

                    <span class="page-label">
                        MY WORK
                    </span>

                    <h1>
                        My Applications
                    </h1>

                    <p>
                        Track the tasks you have applied for.
                    </p>

                </div>

            </div>


            <!-- Summary -->

            <div class="application-summary">

                <div class="application-summary-icon">
                    💼
                </div>

                <div>

                    <span>
                        Total Applications
                    </span>

                    <strong>
                        <%= applications.length %>
                    </strong>

                </div>

            </div>


            <% if (applications.length === 0) { %>


                <!-- Empty -->

                <div class="modern-empty">

                    <div class="empty-circle">
                        💼
                    </div>

                    <h2>
                        No Applications Yet
                    </h2>

                    <p>
                        You haven't applied for any tasks yet.
                    </p>

                    <a
                        href="/dashboard"
                        class="primary-action"
                    >
                        Find Tasks
                    </a>

                </div>


            <% } else { %>


                <!-- Applications -->

                <div class="modern-application-grid">


                    <% applications.forEach((application) => { %>


                        <% if (application.task) { %>


                            <div class="modern-application-card">


                                <!-- Top -->

                                <div class="modern-card-top">

                                    <span class="category-badge">
                                        <%= application.task.category %>
                                    </span>


                                    <% if (application.status === "Pending") { %>

                                        <span class="application-status status-pending">
                                            ● Pending
                                        </span>

                                    <% } else if (application.status === "Accepted") { %>

                                        <span class="application-status status-accepted">
                                            ● Accepted
                                        </span>

                                    <% } else if (application.status === "Rejected") { %>

                                        <span class="application-status status-rejected">
                                            ● Rejected
                                        </span>

                                    <% } else { %>

                                        <span class="application-status">
                                            ● <%= application.status %>
                                        </span>

                                    <% } %>

                                </div>


                                <!-- Title -->

                                <h2 class="modern-application-title">

                                    <%= application.task.title %>

                                </h2>


                                <!-- Description -->

                                <p class="modern-application-description">

                                    <%= application.task.description.length > 120
                                        ? application.task.description.substring(0, 120) + "..."
                                        : application.task.description
                                    %>

                                </p>


                                <!-- Details -->

                                <div class="modern-application-details">


                                    <div>

                                        <span>
                                            Your Bid
                                        </span>

                                        <strong>
                                            ₹<%= application.bidAmount %>
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            Completion Time
                                        </span>

                                        <strong>
                                            <%= application.completionTime %>
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            Task Budget
                                        </span>

                                        <strong>
                                            ₹<%= application.task.budget %>
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            Deadline
                                        </span>

                                        <strong>
                                            <%= new Date(application.task.deadline).toLocaleDateString() %>
                                        </strong>

                                    </div>


                                </div>


                                <!-- Message -->

                                <div class="application-message-box">

                                    <span>
                                        Your Proposal
                                    </span>

                                    <p>
                                        <%= application.message %>
                                    </p>

                                </div>


                                <!-- Buttons -->

                                <div class="modern-application-actions">


                                    <a
                                        href="/tasks/<%= application.task._id %>"
                                        class="modern-secondary-btn"
                                    >
                                        View Task
                                    </a>


                                    <% if (application.status === "Accepted") { %>

                                        <a
                                            href="/tasks/<%= application.task._id %>/submit"
                                            class="modern-primary-btn"
                                        >
                                            Submit Work
                                        </a>

                                    <% } %>


                                    </div>

                            </div>

                        <% } %>

                    <% }) %>

                </div>

            <% } %>

            </div>

    </main>
    
</body>

</html>