<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Notifications | CollegeFreelancing</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <%- include("../partials/navbar") %>


    <main class="notifications-page">

        <div class="notifications-container">


            <!-- Header -->

            <div class="modern-page-header">

                <div>

                    <span class="page-label">
                        UPDATES
                    </span>

                    <h1>
                        Notifications
                    </h1>

                    <p>
                        Stay updated with your latest activity.
                    </p>

                </div>

            </div>


            <% if (notifications.length === 0) { %>


                <!-- Empty -->

                <div class="modern-empty">

                    <div class="empty-circle">
                        🔔
                    </div>

                    <h2>
                        No Notifications
                    </h2>

                    <p>
                        You're all caught up!
                    </p>

                    <a
                        href="/dashboard"
                        class="primary-action"
                    >
                        Back to Dashboard
                    </a>

                </div>


            <% } else { %>


                <div class="modern-notification-list">


                    <% notifications.forEach((notification) => { %>


                        <div
                            class="modern-notification-card
                            <%= notification.isRead ? 'notification-read' : 'notification-unread' %>"
                        >


                            <!-- Icon -->

                            <div class="modern-notification-icon">

                                <% if (notification.isRead) { %>
                                    ✓
                                <% } else { %>
                                    🔔
                                <% } %>

                            </div>


                            <!-- Content -->

                            <div class="modern-notification-content">


                                <div class="notification-top-row">

                                    <div>

                                        <span class="notification-label">
                                            COLLEGEFREELANCING
                                        </span>

                                        <h2>
                                            New Update
                                        </h2>

                                    </div>


                                    <% if (notification.isRead) { %>

                                        <span class="notification-read-badge">
                                            Read
                                        </span>

                                    <% } else { %>

                                        <span class="notification-unread-badge">
                                            New
                                        </span>

                                    <% } %>

                                </div>


                                <!-- Message -->

                                <p class="modern-notification-message">

                                    <%= notification.message %>

                                </p>


                                <!-- Footer -->

                                <div class="modern-notification-footer">


                                    <span class="modern-notification-date">

                                        <% if (notification.createdAt) { %>

                                            <%= new Date(notification.createdAt).toLocaleString() %>

                                        <% } else { %>

                                            Recently

                                        <% } %>

                                    </span>


                                    <% if (notification.task) { %>

                                        <a
                                            href="/tasks/<%= notification.task %>"
                                            class="notification-view-btn"
                                        >
                                            View Task →
                                        </a>

                                    <% } %>


                                </div>


                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>

    </main>


</body>

</html>