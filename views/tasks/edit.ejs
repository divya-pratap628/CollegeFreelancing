<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Task | CollegeFreelancing</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- Navbar -->
    <%- include("../partials/navbar") %>


    <main class="edit-task-container">

        <!-- Back -->

        <a
            href="/tasks/<%= task._id %>"
            class="back-link"
        >
            ← Back to Task
        </a>


        <!-- Main Card -->

        <section class="edit-task-card">

            <!-- Header -->

            <div class="edit-task-header">

                <p class="small-title">
                    TASK MANAGEMENT
                </p>

                <h1>
                    Edit Task ✏️
                </h1>

                <p>
                    Update your project details before publishing
                    the changes.
                </p>

            </div>


            <!-- Form -->

            <form
                action="/tasks/<%= task._id %>?_method=PUT"
                method="POST"
                class="edit-task-form"
            >

                <!-- Title -->

                <div class="edit-form-group">

                    <label for="title">
                        Task Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= task.title %>"
                        placeholder="Enter task title"
                        required
                    >

                </div>


                <!-- Description -->

                <div class="edit-form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="6"
                        placeholder="Describe your task..."
                        required
                    ><%= task.description %></textarea>

                </div>


                <!-- Category -->

                <div class="edit-form-group">

                    <label for="category">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        required
                    >

                        <option
                            value="Assignment"
                            <%= task.category === "Assignment" ? "selected" : "" %>
                        >
                            Assignment
                        </option>

                        <option
                            value="PPT"
                            <%= task.category === "PPT" ? "selected" : "" %>
                        >
                            PPT
                        </option>

                        <option
                            value="Report"
                            <%= task.category === "Report" ? "selected" : "" %>
                        >
                            Report
                        </option>

                        <option
                            value="Coding"
                            <%= task.category === "Coding" ? "selected" : "" %>
                        >
                            Coding
                        </option>

                        <option
                            value="Lab File"
                            <%= task.category === "Lab File" ? "selected" : "" %>
                        >
                            Lab File
                        </option>

                        <option
                            value="Notes"
                            <%= task.category === "Notes" ? "selected" : "" %>
                        >
                            Notes
                        </option>

                        <option
                            value="Mini Project"
                            <%= task.category === "Mini Project" ? "selected" : "" %>
                        >
                            Mini Project
                        </option>

                        <option
                            value="Major Project"
                            <%= task.category === "Major Project" ? "selected" : "" %>
                        >
                            Major Project
                        </option>

                        <option
                            value="Poster"
                            <%= task.category === "Poster" ? "selected" : "" %>
                        >
                            Poster
                        </option>

                        <option
                            value="Other"
                            <%= task.category === "Other" ? "selected" : "" %>
                        >
                            Other
                        </option>

                    </select>

                </div>


                <!-- Budget + Deadline -->

                <div class="edit-two-columns">


                    <div class="edit-form-group">

                        <label for="budget">
                            Budget (₹)
                        </label>

                        <input
                            type="number"
                            id="budget"
                            name="budget"
                            value="<%= task.budget %>"
                            min="1"
                            placeholder="500"
                            required
                        >

                    </div>


                    <div class="edit-form-group">

                        <label for="deadline">
                            Deadline
                        </label>

                        <input
                            type="date"
                            id="deadline"
                            name="deadline"
                            value="<%= new Date(task.deadline).toISOString().split('T')[0] %>"
                            required
                        >

                    </div>

                </div>


                <!-- College -->

                <div class="edit-form-group">

                    <label for="college">
                        College
                    </label>

                    <input
                        type="text"
                        id="college"
                        name="college"
                        value="<%= task.college || '' %>"
                        placeholder="Enter college name"
                        required
                    >

                </div>


                <!-- Actions -->

                <div class="edit-task-actions">

                    <a
                        href="/tasks/<%= task._id %>"
                        class="cancel-edit-btn"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="update-task-btn"
                    >
                        ✓ Update Task
                    </button>

                </div>

            </form>

        </section>

    </main>

</body>

</html>