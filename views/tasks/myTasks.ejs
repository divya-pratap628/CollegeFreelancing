<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Tasks | CollegeFreelancing</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="my-tasks-page">

        <div class="my-tasks-container">

            <!-- Header -->

            <div class="modern-page-header">

                <div>
                    <span class="page-label">WORKSPACE</span>

                    <h1>My Tasks</h1>

                    <p>
                        Manage and track the tasks you have posted.
                    </p>
                </div>

                <a href="/postTask" class="primary-action">
                    + Post New Task
                </a>

            </div>


            <!-- Task Count -->

            <div class="page-summary">

                <div class="summary-icon">
                    📋
                </div>

                <div>
                    <span>Total Tasks</span>

                    <strong>
                        <%= tasks.length %>
                    </strong>
                </div>

            </div>


            <!-- Tasks -->

            <% if (tasks.length === 0) { %>

                <div class="modern-empty">

                    <div class="empty-circle">
                        📭
                    </div>

                    <h2>No Tasks Yet</h2>

                    <p>
                        You haven't posted any tasks yet.
                    </p>

                    <a href="/postTask" class="primary-action">
                        Post Your First Task
                    </a>

                </div>

            <% } else { %>

                <div class="modern-task-grid">

                    <% tasks.forEach((task) => { %>

                        <div class="modern-task-card">

                            <!-- Top -->

                            <div class="modern-card-top">

                                <span class="category-badge">
                                    <%= task.category %>
                                </span>

                                <% if (task.status === "Open") { %>

                                    <span class="modern-status status-open">
                                        ● Open
                                    </span>

                                <% } else if (task.status === "Assigned") { %>

                                    <span class="modern-status status-assigned">
                                        ● Assigned
                                    </span>

                                <% } else if (task.status === "Completed") { %>

                                    <span class="modern-status status-completed">
                                        ● Completed
                                    </span>

                                <% } else { %>

                                    <span class="modern-status status-cancelled">
                                        ● <%= task.status %>
                                    </span>

                                <% } %>

                            </div>


                            <!-- Title -->

                            <h2 class="modern-task-title">
                                <%= task.title %>
                            </h2>


                            <!-- Description -->

                            <p class="modern-task-description">

                                <%= task.description.length > 130
                                    ? task.description.substring(0, 130) + "..."
                                    : task.description
                                %>

                            </p>


                            <!-- Details -->

                            <div class="modern-task-details">

                                <div class="detail-item">

                                    <span>Budget</span>

                                    <strong>
                                        ₹<%= task.budget %>
                                    </strong>

                                </div>


                                <div class="detail-item">

                                    <span>Deadline</span>

                                    <strong>
                                        <%= new Date(task.deadline).toLocaleDateString() %>
                                    </strong>

                                </div>

                            </div>


                            <!-- Buttons -->

                            <div class="modern-task-actions">

                                <a
                                    href="/tasks/<%= task._id %>"
                                    class="modern-view-btn"
                                >
                                    View Task
                                </a>


                                <a
                                    href="/tasks/<%= task._id %>/edit"
                                    class="modern-edit-btn"
                                >
                                    Edit
                                </a>


                                <form
                                    action="/tasks/<%= task._id %>?_method=DELETE"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this task?');"
                                >

                                    <button
                                        type="submit"
                                        class="modern-delete-btn"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </main>

</body>

</html>