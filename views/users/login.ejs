<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | CollegeFreelancing</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <main class="auth-container">

        <section class="auth-card">

            <!-- Logo -->

            <div class="auth-logo">
                🎓
            </div>


            <p class="auth-label">
                COLLEGEFREELANCING
            </p>


            <h1>
                Welcome Back 👋
            </h1>


            <p class="auth-description">
                Login to continue to your account.
            </p>


            <!-- Login Form -->

            <form
                action="/login"
                method="POST"
                class="auth-form"
            >

                <div class="auth-form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="auth-form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="auth-submit-btn"
                >
                    Login →
                </button>

            </form>


            <!-- Register -->

            <div class="auth-footer">

                <p>
                    Don't have an account?
                </p>

                <a href="/register">
                    Create an account
                </a>

            </div>

        </section>

    </main>

</body>

</html>